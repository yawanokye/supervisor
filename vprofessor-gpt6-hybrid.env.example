# Optional live API role configuration. Apply to both web and worker.
# Retain the API key already stored in your deployment settings.
# This file enables no Batch job or interactive chat feature.
VPROF_PRIMARY_PROVIDER=openai
VPROF_ENABLE_OPENAI=true
VPROF_ENABLE_DEEPSEEK=false
OPENAI_MODEL=
OPENAI_MODEL_MODE=roles
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_CLEANING_MODEL=gpt-6-luna
OPENAI_CHAPTER_MODEL=gpt-6.1-sol
OPENAI_SECTION_ANALYSIS_MODEL=gpt-6.1-sol
OPENAI_SECTION_ANALYSIS_FALLBACK_MODEL=gpt-6.1-sol
OPENAI_EXPERT_MODEL=gpt-6.1-sol
OPENAI_FINAL_AUDIT_MODEL=gpt-6.1-sol
OPENAI_FINAL_SYNTHESIS_MODEL=gpt-6.1-sol
OPENAI_FINAL_SYNTHESIS_FALLBACK_MODEL=gpt-6.1-sol
OPENAI_EXTERNAL_DOMAIN_MODEL=gpt-6.1-sol
OPENAI_EXTERNAL_ADJUDICATOR_MODEL=gpt-6.1-sol
OPENAI_PHD_FINAL_SYNTHESIS_MODEL=gpt-6.1-sol
OPENAI_PROMPT_CACHE_ENABLED=true
